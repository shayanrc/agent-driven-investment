digraph deps {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", splines=true, nodesep=0.35, ranksep=0.7,
         labelloc="t", fontsize=15,
         label="Agent-Driven Investment — Active Work Dependency Graph (2026-05-29 00:57 IST)"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.16,0.09", color="#444444"];
  edge  [fontname="Helvetica", fontsize=8, color="#888888"];

  /* ============ LEGEND — horizontal swatch row, forced to the top ============ */
  subgraph cluster_legend {
    label="Legend";
    labelloc="t";
    fontsize=12;
    fontname="Helvetica-Bold";
    style="rounded";
    color="#999999";
    margin=8;
    node [shape=box, style="rounded,filled", fontsize=9, margin="0.12,0.05", height=0.32];
    lg_action [label="actionable now", fillcolor="#d4edda", color="#155724"];
    lg_flight [label="in flight / running", fillcolor="#d1ecf1", color="#0c5460"];
    lg_goal   [label="goal", fillcolor="#ffe69c", color="#856404"];
    lg_pend   [label="pending / gated", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    lg_done   [label="done / merged", fillcolor="#ced4da", color="#495057"];
    lg_recur  [label="recurring (paused)", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
    lg_block  [label="blocked on data", fillcolor="#f8d7da", color="#842029"];
    lg_action -> lg_flight -> lg_goal -> lg_pend -> lg_done -> lg_recur -> lg_block [style=invis];
    { rank=same; lg_action; lg_flight; lg_goal; lg_pend; lg_done; lg_recur; lg_block; }
  }

  /* ============ gbdt · V1.1 agent-driven loop (catboost) ============ */
  subgraph cluster_v11 {
    label="gbdt · V1.1 — agent-driven loop (catboost)";
    labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    LOOP  [label="V1.1 loop machinery ✓ MERGED\nexit/resume + checkpoint + agent_file_protocol", fillcolor="#ced4da", color="#495057"];
    R147  [label="_147 nifty50 H=25 answer key\n(shared validation reference)", fillcolor="#ced4da", color="#495057"];
    INVA  [label="#174 · Investigation A — CATBOOST\nagent-driven loop on nifty50 H=25\nIN FLIGHT (→ acceptance_check_147)", fillcolor="#d1ecf1", color="#0c5460", penwidth=2];
    GOAL161 [label="#161 · V1.1 GOAL\nagent-driven loop PROVEN on BOTH backends\n(closes when A + B done)", fillcolor="#ffe69c", color="#856404", penwidth=2];
  }

  /* ============ gbdt · V1.2 XGBoost backend ============ */
  subgraph cluster_v12 {
    label="gbdt · V1.2 — XGBoost backend";
    labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    XGB16 [label="XGBoost backend ✓ MERGED\nPhases 1–6 (#60/64/65/66/67/68/69 + #70 docs)", fillcolor="#ced4da", color="#495057"];
    A6    [label="#173 · A6 REPLICATION GATE (HARD)\n✓ PASS + MERGED (#71, _148)\nboth cells reproduce CatBoost verdicts\n(indep-verified)", fillcolor="#ced4da", color="#495057", penwidth=2];
    INVB  [label="#175 · Investigation B — XGBOOST\nagent-driven loop on nifty50 H=25\nIN FLIGHT (→ _147 tolerance cmp)", fillcolor="#d1ecf1", color="#0c5460", penwidth=2];
    P8    [label="#176 · Phase 8 — interaction experiments\n+ CatBoost-vs-XGBoost D6 memo (V1.2 track GOAL)\n(gated on A6 + B)", fillcolor="#ffe69c", color="#856404", style="rounded,filled,dashed"];
  }

  /* ============ data_pipelines / sweep ============ */
  subgraph cluster_data {
    label="data_pipelines / sweep";
    labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    SW   [label="#107 · US sweep RUNNING", fillcolor="#d1ecf1", color="#0c5460"];
    ANA  [label="#93 · cross-experiment\nanalysis + SKILL.md", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    BX   [label="#167 · NSE back-extend RUNNING", fillcolor="#d1ecf1", color="#0c5460"];
    N500 [label="#92 · nifty500 experiment", fillcolor="#f8d7da", color="#842029"];
    RERUN[label="#113 · re-run affected exps", fillcolor="#f8d7da", color="#842029"];
  }

  /* ============ scheduled tasks / loops / monitors (recurring, paused between ticks) ============ */
  subgraph cluster_scheduled {
    label="scheduled tasks / loops";
    labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    WAKE [label="#94 · hourly wakeup\n(health-check + PR pipeline + triage)", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
  }

  /* ---- dependencies ---- */
  LOOP  -> INVA [color="#d9534f"];
  LOOP  -> INVB [color="#5a3e9e"];
  XGB16 -> A6   [color="#5a3e9e"];
  XGB16 -> INVB [color="#5a3e9e"];
  A6 -> INVB [label="gate passed", color="#5a3e9e", penwidth=2];
  A6 -> P8   [label="gate passed", color="#5a3e9e", penwidth=2];
  R147 -> A6   [label="shared cell", style=dashed, color="#856404"];
  R147 -> INVA [label="validate vs", style=dashed, color="#856404"];
  R147 -> INVB [label="validate (tol)", style=dashed, color="#856404"];
  INVA -> GOAL161 [color="#d9534f", penwidth=2, label="catboost proven"];
  INVB -> GOAL161 [color="#5a3e9e", penwidth=2, label="xgboost proven"];
  INVB -> P8 [label="tuned xgb model", color="#5a3e9e"];
  INVA -> P8 [label="catboost model", style=dashed, color="#888888"];
  SW -> ANA [label="feeds", style=dashed];
  BX -> N500 [label="unblocks", color="#d9534f"];
  BX -> RERUN [label="unblocks", color="#d9534f"];

  /* force the legend band above every top-of-graph source node */
  lg_block -> LOOP  [style=invis];
  lg_block -> XGB16 [style=invis];
  lg_block -> R147  [style=invis];
  lg_block -> SW    [style=invis];
  lg_block -> BX    [style=invis];
  lg_block -> WAKE  [style=invis];
}
