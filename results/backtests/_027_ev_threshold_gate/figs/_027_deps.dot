digraph deps {
  rankdir=TB; newrank=true;
  graph [fontname="Helvetica", bgcolor="white", splines=true, nodesep=0.35, ranksep=0.75,
         labelloc="t", fontsize=15,
         label="Agent-Driven Investment — _027 EV-breakeven threshold gate backtest\n2026-06-28 12:48 IST"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.16,0.09", color="#444444"];
  edge [fontname="Helvetica", fontsize=8, color="#888888"];

  legend [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="6" BGCOLOR="#f6f6f6">
      <TR><TD COLSPAN="6" BORDER="0"><FONT FACE="Helvetica" POINT-SIZE="11"><B>legend</B></FONT></TD></TR>
      <TR>
        <TD BGCOLOR="#ced4da"><FONT FACE="Helvetica" POINT-SIZE="10">done / merged</FONT></TD>
        <TD BGCOLOR="#a8d8c0"><FONT FACE="Helvetica" POINT-SIZE="10">done this session</FONT></TD>
        <TD BGCOLOR="#d4edda"><FONT FACE="Helvetica" POINT-SIZE="10">actionable now</FONT></TD>
        <TD BGCOLOR="#ffffff" STYLE="dashed"><FONT FACE="Helvetica" POINT-SIZE="10">pending / gated</FONT></TD>
        <TD BGCOLOR="#d1ecf1" STYLE="dotted"><FONT FACE="Helvetica" POINT-SIZE="10">recurring (paused)</FONT></TD>
        <TD BGCOLOR="#ffe69c"><FONT FACE="Helvetica" POINT-SIZE="10">goal</FONT></TD>
      </TR>
    </TABLE>>];
  spacer_L [shape=point, width=0.01, style=invis];
  spacer_C [shape=point, width=0.01, style=invis];
  spacer_R [shape=point, width=0.01, style=invis];
  {rank=min; legend;}
  {rank=same; spacer_L; spacer_C; spacer_R;}
  legend -> spacer_L [style=invis, weight=1];
  legend -> spacer_C [style=invis, weight=100];
  legend -> spacer_R [style=invis, weight=1];
  spacer_L -> AUC_JOIN  [style=invis, weight=100];
  spacer_C -> GATE_INFRA [style=invis, weight=100];
  spacer_R -> DAILY     [style=invis, weight=100];

  subgraph cluster_ctx { label="context · done"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    AUC_JOIN   [label="AUC join: leaderboard ↔ gbdt registry\n(22/23 models, R-p@{3,10})", fillcolor="#a8d8c0", color="#1e6b4f"];
    GATE_INFRA [label="_026 raw-p gate infra\n--min-entry-p-raw (merged #229)", fillcolor="#ced4da", color="#495057"];
  }
  subgraph cluster_derive { label="_027 · breakeven-τ derivation (eval ROC) · done"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    ROC    [label="eval ROC: TPR/FPR per model\n(held-out split, leak-free)", fillcolor="#a8d8c0", color="#1e6b4f"];
    TAU    [label="breakeven τ = min p_raw s.t.\nprecision ≥ loss/(target+loss)", fillcolor="#a8d8c0", color="#1e6b4f"];
    COUNTS [label="14/23 clear breakeven\n(sp500_20 champ + bear cells: NO trade)", fillcolor="#a8d8c0", color="#1e6b4f"];
  }
  subgraph cluster_bt { label="_027 · backtest sweep (test/OOS) · now"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    BASE   [label="baseline backtests\n14 cells · champion rank/equal K=3", fillcolor="#d4edda", color="#155724"];
    EVGATE [label="EV-gate backtests\ngate p_raw≥τ + top-3 · 14 cells", fillcolor="#d4edda", color="#155724"];
    AGG    [label="aggregate: Δ vs baseline,\nleaderboard placement, bull vs bear", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
  }
  subgraph cluster_ship { label="_027 · document + ship · pending"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    MEMO    [label="_027 memo + INDEX + results figure", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    PRMERGE [label="PR + autonomous review/merge\n(rebase, retain branch)", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
  }
  subgraph cluster_sched { label="scheduled tasks / loops"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    DAILY [label="/daily-predictions cadence\n(deployed champions; paused)", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
    CKPT  [label="git checkpoints\ncommit + push each phase", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
  }
  GOAL [label="verdict: does an EV-breakeven gate\nbeat baseline / break the top-10?", fillcolor="#ffe69c", color="#856404", penwidth=2];

  AUC_JOIN -> ROC [color="#d9534f", penwidth=1.6];
  ROC -> TAU [color="#d9534f", penwidth=1.6];
  TAU -> COUNTS [color="#d9534f", penwidth=1.6];
  TAU -> EVGATE [color="#d9534f", penwidth=1.6];
  GATE_INFRA -> EVGATE [style=dashed];
  COUNTS -> BASE [style=dashed];
  AUC_JOIN -> BASE [style=dashed];
  BASE -> AGG [color="#d9534f", penwidth=1.6];
  EVGATE -> AGG [color="#d9534f", penwidth=1.6];
  AGG -> MEMO [color="#d9534f", penwidth=1.6];
  MEMO -> PRMERGE [color="#d9534f", penwidth=1.6];
  PRMERGE -> GOAL [color="#d9534f", penwidth=1.6];
  CKPT -> EVGATE [style=dotted, color="#0c5460"];
  CKPT -> AGG [style=dotted, color="#0c5460"];
  CKPT -> PRMERGE [style=dotted, color="#0c5460"];
}
