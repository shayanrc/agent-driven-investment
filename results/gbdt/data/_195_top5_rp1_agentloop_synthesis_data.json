  "findings_F1_to_F6": {
    "F1_L2_grid_overregularizes_strong_top1": {
      "claim": "mcw=10 grid endpoint regresses top-1 by -20% to -32% on all 3 strong-top-1 cells (1, 3, 4).",
      "evidence": "cell-1 0.800 -> 0.640 (-20%); cell-3 0.600 -> 0.413 (-31%); cell-4 0.549 -> 0.373 (-32%).",
      "mechanism": "mcw=10 caps leaf weights -> smooths prediction tail -> kills very-high-confidence top picks. L1 tie-break (gap + Z) actively selects most-regularized iter."
    },
    "F2_no_universal_fix": {
      "claim": "No single recipe transfers across strong-top-1 cells.",
      "evidence": "Cell-4 mix recipe beat sweep R-p@1 +21% (0.549 -> 0.667); same recipe on cell-1 -55% (0.800 -> 0.360); same on cell-3 -60% (0.600 -> 0.240)."
    },
    "F3_asymmetry_hint_n3": {
      "claim": "sp500 (large panel) cells respond differently to FS+stacked-reg than nasdaq100 (small panel) cell.",
      "caveat": "n=3 cells, do not over-read.",
      "hypothesis": "Aggressive FS+stacked-reg on larger panels collapses the diversity sweep was using for top picks."
    },
    "F4_val_test_divergence": {
      "claim": "val_brier movement does not track test ranking shifts in the prediction tail.",
      "evidence": [
        "cell-4 colsample variant: val Δ=+0.00001 (noise), test R-p@1 0.373 -> 0.431 (+16%).",
        "cell-4 mix iter_1: val_brier 0.023441 WORSE than gamma stack's 0.023363, but test R-p@1 0.667 BETTER than gamma stack's 0.353."
      ],
      "implication": "L1 tie-break (calibrated on val gap + Z) is the wrong objective for top-1-driven cells."
    },
    "F5_single_knob_plateau_bug204": {
      "claim": "Runner's auto-plateau fires per-knob, silencing entire response surfaces.",
      "evidence": "Cell-4: mcw=10 val Δ=0.0012 plateau-stopped before colsample / gamma could be tested, masking the +16% colsample lift.",
      "workaround": "Set plateau_threshold=0.0001 in spec; chain fresh-variant specs that pre-bake prior state via iter_0_decision.",
      "fix_in_flight": "Bug #204: disable auto-plateau in agent_file_protocol mode, keep for sweep mode."
    },
