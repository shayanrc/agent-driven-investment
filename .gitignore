# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Virtual envs (uv.lock IS committed; .venv/ is local-only)
.venv/

# Data files — committed via .gitkeep, contents excluded
data/*
!data/.gitkeep

# Run artifacts — committed via .gitkeep, contents excluded
runs/**
!runs/.gitkeep
!runs/*/
!runs/*/.gitkeep

# OS
.DS_Store

# Append-only: data_pipelines raw cache (immutable per-fetch downloads)
data/raw/
data/processed/

# forecasters: user-tuned presets + cached forecasts (committed via .gitkeep,
# contents excluded). Specific user-tuned presets that need to be checked in
# (e.g., the NIFTY 500 acceptance-demo preset) are added explicitly with
# `git add -f`.
results/forecasters/presets/*
!results/forecasters/presets/.gitkeep
results/forecasters/forecasts/*
!results/forecasters/forecasts/.gitkeep

# gbdt: per-run feature-matrix cache (task #181) — a build-time optimization
# for the exit-and-resume agent loop. Derivable from the panel + spec, so it is
# never committed (the full candidate matrix can be large on heavy panels).
results/gbdt/experiments/**/_feature_matrix_cache.parquet
results/gbdt/experiments/**/_feature_matrix_cache.key.json

# gbdt-diagnose: per-cell in-sample matrix cache for /gbdt-diagnose
# (derivable from the panel + spec; reused on re-run for fast iteration on
# --top-n / --no-pdp; can be ~700 MB on US universes, never committed).
results/gbdt/experiments/**/diagnose/_insample_matrix.parquet

# Run logs — captured stdout, often carries machine-specific paths from
# Python tracebacks. The cache fingerprint that mattered (size + mtime +
# code_commit) lives in metrics.json instead. Evidence-worthy logs can
# still be force-added via ``git add -f`` (the 5 pre-existing tracked
# logs were sanitized in #253 and remain as memo evidence).
logs/

# Local secrets
.env

# Bash-driven test scratch (task #191 — run_agent_loop_resumable.sh)
tests/gbdt/tmp/
# Large regenerable fresh-prediction CSVs (rebuild via infer_fresh_predictions)
results/backtests/_008_roll/*_fresh.csv
