# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Virtual envs (uv.lock IS committed; .venv/ is local-only)
.venv/

# Data files — committed via .gitkeep, contents excluded
data/*
!data/.gitkeep

# Run artifacts — committed via .gitkeep, contents excluded
runs/**
!runs/.gitkeep
!runs/*/
!runs/*/.gitkeep

# OS
.DS_Store

# Append-only: data_pipelines raw cache (immutable per-fetch downloads)
data/raw/
data/processed/

# forecasters: user-tuned presets + cached forecasts (committed via .gitkeep,
# contents excluded). Specific user-tuned presets that need to be checked in
# (e.g., the NIFTY 500 acceptance-demo preset) are added explicitly with
# `git add -f`.
results/forecasters/presets/*
!results/forecasters/presets/.gitkeep
results/forecasters/forecasts/*
!results/forecasters/forecasts/.gitkeep

# gbdt experiment artifact dirs are local by default. The committed record for
# a cell is its spec (configs/gbdt/experiments/), its registry row
# (results/gbdt/data/r_precision_at_k.csv), the memo, and the aggregated JSONs
# in results/gbdt/data/. Sweep arms alone were accumulating ~50 MB/dir of
# regenerable models + prediction CSVs. Artifacts that back a memo directly
# (embedded figs, cited metrics.json/report.md) are force-added deliberately:
#     git add -f results/gbdt/experiments/<cell>/<paths>
# The ~130 historically committed cells stay tracked (ignore rules never
# untrack).
results/gbdt/experiments/*

# Run logs — captured stdout, often carries machine-specific paths from
# Python tracebacks. The cache fingerprint that mattered (size + mtime +
# code_commit) lives in metrics.json instead. Evidence-worthy logs can
# still be force-added via ``git add -f`` (the 5 pre-existing tracked
# logs were sanitized in #253 and remain as memo evidence).
logs/

# Local secrets
.env

# Bash-driven test scratch (task #191 — run_agent_loop_resumable.sh)
tests/gbdt/tmp/
# Large regenerable fresh-prediction CSVs (rebuild via infer_fresh_predictions)
results/backtests/_008_roll/*_fresh.csv
results/backtests/_009_nifty/*_fresh.csv
results/backtests/_019_fwd_oos/*_fresh.csv
# Figure policy: figures embedded in a memo narrative stay committed (e.g. the
# canonical _019_fwd_oos/figs/ set); regenerable analysis figures that no memo
# embeds do not. The dated predicted_prob_* series is re-emitted by
# scripts/backtests/analyze_forward_prob.py on each run; the _029 per-cell figs
# are re-emitted by the k-sweep runner (the CSV/JSON data alongside them IS
# committed).
results/backtests/_019_fwd_oos/predicted_prob_*.png
results/backtests/_019_fwd_oos/predicted_prob_*.svg
results/backtests/_029_k_sweep/*/figs/
# valuation: large regenerable daily panel + split cache (rebuild via
# scripts.valuation.build_valuation_panel); the latest-snapshot CSV is checked in
results/valuation/data/valuation_panel.parquet
results/valuation/data/split_factors.parquet
