# data_pipelines — API keys and runtime env vars.
#
# Copy this file to .env (gitignored) and fill in your values:
#     cp .env.example .env
#     $EDITOR .env
#
# The .env file is loaded automatically when `import data_pipelines` runs
# (via python-dotenv). Values already set in the real environment take
# precedence over .env (so CI / shell exports always win).
#
# NEVER commit .env. The file is in .gitignore.

# ---------------------------------------------------------------------------
# us_equities domain
# ---------------------------------------------------------------------------

# Stooq seed adapter. Free registration (captcha-only) at:
#   https://stooq.com/q/d/?s=aapl.us&get_apikey
STOOQ_API_KEY=

# Tiingo update adapter. Free tier 500 req/day. Register at:
#   https://api.tiingo.com/account/api/token
TIINGO_API_KEY=

# ---------------------------------------------------------------------------
# Optional: TLS / proxy
# ---------------------------------------------------------------------------

# Override only if your machine's default cert bundle doesn't trust the
# providers (e.g., corporate MITM proxy). Path to a PEM bundle.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
