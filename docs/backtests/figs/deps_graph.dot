digraph deps {
  rankdir=TB;
  newrank=true;
  graph [fontname="Helvetica", bgcolor="white", splines=true, nodesep=0.35, ranksep=0.7,
         labelloc="t", fontsize=15,
         label="Agent-Driven Investment — backtests V1.1 sizing + agent-cell survey (2026-06-16 15:30 — V2.4 forward-OOS pipeline shipped (incremental --since + /daily-predictions skill + systemd timer))"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.16,0.09", color="#444444"];
  edge [fontname="Helvetica", fontsize=8, color="#888888"];

  /* ---------- legend ---------- */
  legend [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="6" BGCOLOR="#f6f6f6">
      <TR><TD COLSPAN="7" BORDER="0"><FONT FACE="Helvetica" POINT-SIZE="11"><B>legend</B></FONT></TD></TR>
      <TR>
        <TD BGCOLOR="#ced4da"><FONT FACE="Helvetica" POINT-SIZE="10">done / merged</FONT></TD>
        <TD BGCOLOR="#a8d8c0"><FONT FACE="Helvetica" POINT-SIZE="10">done this session</FONT></TD>
        <TD BGCOLOR="#d4edda"><FONT FACE="Helvetica" POINT-SIZE="10">actionable</FONT></TD>
        <TD BGCOLOR="#d1ecf1"><FONT FACE="Helvetica" POINT-SIZE="10">in flight</FONT></TD>
        <TD BGCOLOR="#ffffff" STYLE="dashed"><FONT FACE="Helvetica" POINT-SIZE="10">pending / gated</FONT></TD>
        <TD BGCOLOR="#d1ecf1"><FONT FACE="Helvetica" POINT-SIZE="10">recurring (paused)</FONT></TD>
        <TD BGCOLOR="#ffe69c"><FONT FACE="Helvetica" POINT-SIZE="10">goal</FONT></TD>
      </TR>
    </TABLE>
  >];
  spacer_L [shape=point, width=0.01, style=invis];
  spacer_C [shape=point, width=0.01, style=invis];
  spacer_R [shape=point, width=0.01, style=invis];
  {rank=min;  legend;}
  {rank=same; spacer_L; spacer_C; spacer_R;}
  legend -> spacer_L [style=invis, weight=1];
  legend -> spacer_C [style=invis, weight=100];
  legend -> spacer_R [style=invis, weight=1];

  /* ---------- cluster: V1 (merged) ---------- */
  subgraph cluster_v1 { label="backtests · V1 (merged)"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    PLUMBING [label="V1 plumbing\ncalibration + trading_strategies\n(PR #161)", fillcolor="#ced4da", color="#495057"];
    M001 [label="_001 cell5 half-Kelly\n+6.7% vs NDX +23%\n(132-day gap confound)", fillcolor="#ced4da", color="#495057"];
  }

  /* ---------- cluster: V1.1 this session ---------- */
  subgraph cluster_session { label="backtests · V1.1 — fresh-OOS + sizing (this session)"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    REFRESH [label="data refresh → 2026-06-12\n+ fixed circular data/raw symlink", fillcolor="#a8d8c0", color="#495057"];
    INFER [label="infer_fresh_predictions\n(no retrain; self-check 1.5e-8)", fillcolor="#a8d8c0", color="#495057"];
    M002 [label="_002 fresh-OOS half-Kelly\n+9.0% vs NDX +21.6%\n(PR #162)", fillcolor="#a8d8c0", color="#495057"];
    M003 [label="_003 sizing sweep\nc=0.25+mean +25.4% > NDX\np_low HURTS (PR #163)", fillcolor="#a8d8c0", color="#495057"];
    M004 [label="_004 best-agent-cell survey\n5 cells × {c=.25,.5}\nonly cell-5 trades", fillcolor="#a8d8c0", color="#495057"];
    M004DOC [label="_004 memo + registry + PR", fillcolor="#d1ecf1", color="#0c5460"];
  }

  /* ---------- cluster: follow-ups (pending) ---------- */
  subgraph cluster_follow { label="backtests · follow-ups (pending / gated)"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    PROMOTE [label="promote c=0.25+mean\nas headline sizing default", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    BREAKEVEN [label="FINDING: base-rate gate\n4/5 best agent cells = 0 trades\n(calibrated p never > 1/3)", fillcolor="#a8d8c0", color="#495057"];
    RANKSIZE [label="_005 V1.2 rank-sizing — rank/equal\ndeploys the signal: 4/5 cells BEAT\nindex OOS (ndx40 +61.5%, sp500_20 +58%)", fillcolor="#a8d8c0", color="#495057"];
    ROLLVAL [label="_006 rolling validation — GATE FIRED\ncell-5 family: NO consistent edge vs NDX\n(38-46% of 50d windows beat)", fillcolor="#a8d8c0", color="#495057"];
    FAITHFUL [label="_007 faithful _mix inference FIXED\n(drop gap-fill AZN row) → ndx40 ROLLS:\n+121.7%, 57% windows beat NDX, med +6.6%", fillcolor="#a8d8c0", color="#495057"];
    UNIREFRESH [label="_008 sp500+r1k refreshed & rolled\nALL beat index: sp500_20 100%, sp500_50 92%,\nr1k_50 90% (3yr). AUC tracks the edge", fillcolor="#a8d8c0", color="#495057"];
    NIFTY [label="_009 nifty500 rolled (5 cells)\nUS AUC→edge does NOT transfer to NSE:\nhigh-AUC +50% cells BLEW UP (DD -37/-60%)\non a -4.8% down tape; regime is the gate", fillcolor="#a8d8c0", color="#495057"];
    REGIME [label="_010 regime-conditioning — HYPOTHESIS REFUTED\nedge is NOT long-beta (US ρ≈0, regime-neutral);\nregime does NOT explain US-NSE gap\n(US-down +10%/98% vs NSE-down +0.2%/53%)", fillcolor="#a8d8c0", color="#495057"];
    FORENSICS [label="_011 NSE forensics — it's the BASE RATE\nNSE AUC is real (fresh≈test) + capturable;\nbut top-1 wins 6-10% vs US 43-48% (events 5-20x rarer).\nR-p@1 (abs × lift>1), NOT AUC, predicts edge", fillcolor="#a8d8c0", color="#495057"];
    RERANK [label="_012 re-rank + wider-K — MATCH K TO PRECISION\nwider-K = risk-reducer not edge-creator;\nrescued worst NSE blow-up to ~breakeven (K=10)\nbut HURT cells that worked (high R-p@1 wants K=3)", fillcolor="#a8d8c0", color="#495057"];
    PRECW [label="_013 precision-weighted sizing (bet ∝ p)\nraw-p too FLAT to concentrate → spreads to whole\nuniverse (r1k 890 entries): best de-risker but\nDESTROYS high-Rp@1 edge (sp500 92→38%, r1k 90→4%)", fillcolor="#a8d8c0", color="#495057"];
    SHARPW [label="_014 sharper weights (p^α, α∈{2,4,8}) — FAILS\nnever concentrates (entries stay full-universe 486/890);\nedge is in SELECTION not weighting.\nPRECISION-WEIGHTING THREAD CLOSED → champion = equal top-3", fillcolor="#a8d8c0", color="#495057"];
    BOOTSTRAP [label="_015 validate champion — HOLDS (1 demotion)\ncost-robust to 50bps (high-turnover variant→0%);\nbootstrap CI excludes 0 on sp500_50/sp500_20/r1k_50\n(ndx40 n.s.); beats index in worst sub-window", fillcolor="#ced4da", color="#495057"];
    FWDOOS [label="_016 REAL-bear OOS (retrain, test=2022 bear) — EDGE COLLAPSES\nbull 92-100% windows beat → bear 53/50% (coin-flip), median +7-10%→~0%;\nDD AMPLIFIES -32/-35% vs index -25%. Bull/range-bound ONLY.\nCorrects _010/_015 'regime-neutral' (a dip is not a bear)", fillcolor="#ced4da", color="#495057"];
    REGIMEGATE [label="_017 REGIME GATE — risk-reducer, NOT alpha-restorer\nbull edge PRESERVED (SMA200, ~11% gated: 92→100%, +73.7→+81%);\nbear NOT rescued at any MA speed (can't avoid Jan-22 top entries —\nirreducible lag); lone win = DD -32→-22%. Deploy SMA200, NOT all-weather", fillcolor="#ced4da", color="#495057"];
    REGIMERESEARCH [label="_018 FORWARD-LOOKING signals (vol/drawdown/breadth) — NONE rescue bear\nall preserve bull (≥89% beat) but every one negative in bear, fast ones WORSE\n(drawdown -36%, vol -30%); refutes lag → NO up-move edge to gate toward (_016).\nKeep simple SMA200. REGIME-GATE THREAD CLOSED.", fillcolor="#a8d8c0", color="#495057"];
    OPENITEMS [label="NEXT (external to decision policy): forward OOS as cache ages\n+ a 2nd bear (2020/2008) to confirm no-bear-edge generalizes.\nA real BEAR EDGE needs a NEW down-move/short target, NOT an overlay", fillcolor="#d4edda", color="#155724"];
    FWDRUN [label="_019 forward-OOS PIPELINE — built & verified\nincremental infer (--since, BIT-IDENTICAL to full max|Δ|=0, ~3x faster);\nidempotent + self-gating + backfilling; /daily-predictions skill + systemd timer;\ncommitted forward log (1050 rows, sp500 → 06-15; regime captured per day)", fillcolor="#a8d8c0", color="#495057"];
    ROLLING [label="DAILY forward-prediction cadence (now automated by _019)\n/daily-predictions + systemd user timer (Persistent) → append top-10/day\nto forward_predictions_log.csv; grows honest eff-N over wall-clock", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
    GAPEVAL [label="signal-gap-aware eval harness\n(invested-days / cash-adj bench)", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    IDFIX [label="registry id zero-pad fix\n(fold into next PR)", fillcolor="#ffffff", color="#adb5bd", style="rounded,filled,dashed"];
    GOAL [label="GOAL: agent-driven strategy that\nbeats passive OOS across cells", fillcolor="#ffe69c", color="#856404", penwidth=2];
  }

  /* ---------- cluster: gbdt cross-module follow-ups (discovered here) ---------- */
  subgraph cluster_gbdt { label="gbdt · cross-module follow-ups (discovered)"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    GBDTPERF [label="PERF: parallelize gbdt feature build (src/gbdt/features.py)\n_019 incremental --since already cut ~18→~6 min/cell (slice, bit-identical).\nREMAINING: fan per-ticker F1-F13/F15/F16 over cores (joblib) + vectorize the\nrolling().apply rank (~L310) + per-ticker corr/cov loops (~275/373) to cut\nthe ~6 min further. gbdt-owned; own correctness checks. (V1.4_TBD row 3)", fillcolor="#d4edda", color="#155724"];
  }

  /* ---------- cluster: scheduled ---------- */
  subgraph cluster_sched { label="scheduled tasks / loops"; labelloc="t"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#b0b0b0"; margin=12;
    WAKE [label="hourly heartbeat\n(cron :07 — disk/subagents/PRs)", fillcolor="#d1ecf1", color="#0c5460", style="rounded,filled,dotted"];
  }

  /* anchors: every cluster top node pulled from a spacer */
  spacer_L -> PLUMBING [style=invis, weight=100];
  spacer_C -> REFRESH  [style=invis, weight=100];
  spacer_R -> PROMOTE  [style=invis, weight=100];
  spacer_R -> WAKE     [style=invis, weight=20];
  spacer_R -> GBDTPERF [style=invis, weight=20];

  /* ---------- dependency edges ---------- */
  PLUMBING -> M001;
  M001 -> REFRESH [style=dashed];
  REFRESH -> INFER -> M002 -> M003;
  M003 -> M004;
  M004 -> M004DOC;
  M003 -> PROMOTE [color="#5a3e9e"];
  M004 -> PROMOTE [color="#5a3e9e"];
  M004 -> BREAKEVEN [color="#d9534f"];
  BREAKEVEN -> RANKSIZE [color="#d9534f"];
  RANKSIZE -> ROLLVAL [color="#d9534f"];
  ROLLVAL -> FAITHFUL [color="#d9534f"];
  ROLLVAL -> UNIREFRESH [color="#d9534f"];
  FAITHFUL -> UNIREFRESH [color="#d9534f"];
  UNIREFRESH -> NIFTY [color="#d9534f"];
  NIFTY -> REGIME [color="#d9534f"];
  REGIME -> FORENSICS [color="#d9534f"];
  FORENSICS -> RERANK [color="#d9534f"];
  RERANK -> PRECW [color="#d9534f"];
  PRECW -> SHARPW [color="#d9534f"];
  SHARPW -> BOOTSTRAP [color="#d9534f"];
  BOOTSTRAP -> FWDOOS [color="#d9534f"];
  FWDOOS -> REGIMEGATE [color="#d9534f"];
  REGIMEGATE -> REGIMERESEARCH [color="#d9534f"];
  REGIMERESEARCH -> OPENITEMS [color="#d9534f"];
  OPENITEMS -> GOAL [color="#d9534f"];
  OPENITEMS -> FWDRUN [color="#0c5460"];
  FWDRUN -> ROLLING [style=dashed, color="#0c5460"];
  FWDRUN -> GBDTPERF [style=dashed, label="discovered: slow cold rebuild", color="#888888"];
  INFER -> ROLLING [style=dashed];
  M001 -> GAPEVAL [style=dashed];
  M004DOC -> IDFIX [style=dashed];
  PROMOTE -> GOAL [color="#5a3e9e"];
  ROLLING -> GOAL [style=dashed];
  BREAKEVEN -> GOAL [style=dashed];
}
