digraph tasks {
  rankdir=TB;
  fontname="Helvetica";
  bgcolor="white";
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=9];
  graph [labelloc="t", label="agent-driven-investment — date-aligned refit + true-OOS pipeline (2026-06-23 00:53 IST)\nbranch gbdt-trailing-champions-date-aligned · refit 5 trailing champions on date_aligned, then top-10 true-OOS rerun", fontsize=13, fontname="Helvetica-Bold"];

  // Legend in isolated top rank
  {
    rank=source;
    legend [shape=none, margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="6" BGCOLOR="#f0f0f0"><B>Legend</B></TD></TR>
        <TR>
          <TD BGCOLOR="#a4e9a4">actionable</TD>
          <TD BGCOLOR="#a3c8e8">in-flight</TD>
          <TD BGCOLOR="#ffd966">goal</TD>
          <TD BGCOLOR="#ffffff">pending / gated (dashed)</TD>
          <TD BGCOLOR="#cccccc">done / merged</TD>
          <TD BGCOLOR="#a3c8e8">recurring (dotted)</TD>
        </TR>
        <TR><TD COLSPAN="6" BGCOLOR="#f8f8f8">solid edge = hard dep · dashed = soft / context · green = critical path</TD></TR>
      </TABLE>
    >];
  }

  // Recently merged (context)
  subgraph cluster_done {
    label = "Recently merged (context)";
    style = "filled"; fillcolor = "#fafafa"; color = "#cccccc";
    fontname = "Helvetica-Bold"; fontsize = 11;
    macro [label="macro program (F17)\nconcluded — not deployed\n(_258–_264)", fillcolor="#cccccc"];
    paths [label="path cleanup + venv fix\n(#209) — relative-from-root", fillcolor="#cccccc"];
  }

  // Phase A — date-aligned matched refits
  subgraph cluster_A {
    label = "Phase A — date-aligned matched refits (5 trailing champions)";
    style = "rounded"; color = "#3366aa"; fontname = "Helvetica-Bold"; fontsize = 11;
    A1 [label=<<B>A1</B> generate 5 specs<BR/>pin HP+features, single fit<BR/>gen_aligned_champion_specs.py>, fillcolor="#cccccc"];
    A2 [label=<<B>A2</B> run 5 refits<BR/>date_aligned single fit<BR/>(5/5 done; nasdaq via exclude)>, fillcolor="#cccccc"];
    A3 [label=<<B>A3</B> R-p@K &rarr; registry<BR/>+5 rows (164 total)<BR/>r_precision_at_k.csv>, fillcolor="#cccccc"];
    A4 [label=<<B>A4</B> memo _265 + commit<BR/>Phase A>, fillcolor="#a3c8e8"];
  }

  // Phase B — top-10 true-OOS rerun
  subgraph cluster_B {
    label = "Phase B — top-10 &rarr; true post-test-set OOS rerun";
    style = "rounded"; color = "#aa6633"; fontname = "Helvetica-Bold"; fontsize = 11;
    B1 [label=<<B>B1</B> select top-10<BR/>from updated registry>, fillcolor="#ffffff", style="rounded,filled,dashed"];
    B2 [label=<<B>B2</B> true-OOS inference<BR/>each model: dates &gt; its test_end<BR/>(complete labels)>, fillcolor="#ffffff", style="rounded,filled,dashed"];
    B3 [label=<<B>B3</B> realized R-p@K<BR/>on the OOS window<BR/>+ assemble table>, fillcolor="#ffffff", style="rounded,filled,dashed"];
    B4 [label=<<B>B4</B> memo + commit<BR/>Phase B>, fillcolor="#ffffff", style="rounded,filled,dashed"];
  }

  // Goal
  subgraph cluster_goal {
    label = "Goal"; style = "filled"; fillcolor = "#fffcec"; color = "#cc9933";
    fontname = "Helvetica-Bold"; fontsize = 11;
    G [label="date-aligned + true-OOS\nmetrics for the backtested\nchampions", fillcolor="#ffd966", shape=octagon];
  }

  // Legend centering anchors
  legend -> macro [style="invis", weight=100];
  legend -> A1 [style="invis", weight=100];
  legend -> B1 [style="invis", weight=100];
  legend -> G  [style="invis", weight=100];

  // context -> start (soft)
  paths -> A1 [style="dashed", color="#999999", label="branch off main"];

  // Phase A critical path
  A1 -> A2 [color="#2e8b57", penwidth=2];
  A2 -> A3 [color="#2e8b57", penwidth=2];
  A3 -> A4 [color="#2e8b57", penwidth=2];

  // A3 gates Phase B (registry must be updated before top-10 select)
  A3 -> B1 [color="#cc3333", penwidth=2, label="registry updated"];
  B1 -> B2 [color="#2e8b57", penwidth=2];
  B2 -> B3 [color="#2e8b57", penwidth=2];
  B3 -> B4 [color="#2e8b57", penwidth=2];

  // -> goal
  A4 -> G [style="dashed", color="#338866"];
  B4 -> G [color="#cc3333", penwidth=2];
}
