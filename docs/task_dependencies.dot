digraph tasks {
  rankdir=TB;
  fontname="Helvetica";
  bgcolor="white";
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=9];
  graph [labelloc="t", label="agent-driven-investment — agent-tune the 3 un-tuned top-200d cells (2026-06-23 16:35 IST)\nbranch gbdt-200d-aligned-agent-tune · sub-agent per cell (sole driver) · separate commit per experiment\n3/3 DONE: agent-tuning did NOT beat sweep — _268 verdict: backend (CatBoost) dominates at H=200 (vintage rejected)\n_269 (2026-06-23 21:35 IST): CatBoost agent-tune ×3 — HIGH-VARIANCE: sp500/50 WON big (@1 0.930 vs 0.630), russell + sp500/40 LOST @1 → CatBoost sweep stays the H=200 default", fontsize=13, fontname="Helvetica-Bold"];

  // Legend in isolated top rank
  {
    rank=source;
    legend [shape=none, margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="6" BGCOLOR="#f0f0f0"><B>Legend</B></TD></TR>
        <TR>
          <TD BGCOLOR="#a4e9a4">actionable</TD>
          <TD BGCOLOR="#a3c8e8">in-flight</TD>
          <TD BGCOLOR="#ffd966">goal</TD>
          <TD BGCOLOR="#ffffff">pending / gated (dashed)</TD>
          <TD BGCOLOR="#cccccc">done / merged</TD>
          <TD BGCOLOR="#a3c8e8">recurring (dotted)</TD>
        </TR>
        <TR><TD COLSPAN="6" BGCOLOR="#f8f8f8">solid edge = hard dep · dashed = soft / context · red = sequential single-writer chain</TD></TR>
      </TABLE>
    >];
  }

  // Context — merged
  subgraph cluster_done {
    label = "Context (merged)";
    style = "filled"; fillcolor = "#fafafa"; color = "#cccccc";
    fontname = "Helvetica-Bold"; fontsize = 11;
    prior [label="_265 + _266 pipeline (PR #210)\ndate-aligned refits + true-OOS rerun", fillcolor="#cccccc"];
    ident [label="top-10 analysis: 3 un-tuned 200d\nsweep cells (also _266 OOS failures)", fillcolor="#cccccc"];
  }

  // Phase — agent-tune
  subgraph cluster_tune {
    label = "Agent-tune (xgboost, V1.3 scout + agent_file_protocol, date-aligned 2018-anchor)";
    style = "rounded"; color = "#3366aa"; fontname = "Helvetica-Bold"; fontsize = 11;
    C1 [label=<<B>C1</B> sp500 +50%/200d ✓<BR/>test @1 0.623 @3 0.454<BR/>(sweep @3 0.569 — matched @1, lost @3+)>, fillcolor="#cccccc"];
    C2 [label=<<B>C2</B> sp500 +40%/200d ✓<BR/>test @1 0.697 @3 0.468<BR/>(sweep @3 0.556 — lost @1-@5)>, fillcolor="#cccccc"];
    C3 [label=<<B>C3</B> russell1000 +40%/200d ✓<BR/>test @1 0.447 @3 0.457<BR/>(sweep @3 0.570; agent wins K≥5)>, fillcolor="#cccccc"];
    K1 [label=<commit: sp500_50 ✓<BR/>17e8993>, fillcolor="#cccccc"];
    K2 [label=<commit: sp500_40 ✓<BR/>d36c45b>, fillcolor="#cccccc"];
    K3 [label=<commit: russell_40 ✓<BR/>7820a87>, fillcolor="#cccccc"];
  }

  // Finalize
  subgraph cluster_fin {
    label = "Finalize";
    style = "rounded"; color = "#aa6633"; fontname = "Helvetica-Bold"; fontsize = 11;
    FIN [label=<<B>FIN</B> memo _267 + PR<BR/>3/3: agent did not beat sweep @1/@3>, fillcolor="#a3c8e8"];
  }

  // Goal
  subgraph cluster_goal {
    label = "Goal"; style = "filled"; fillcolor = "#fffcec"; color = "#cc9933";
    fontname = "Helvetica-Bold"; fontsize = 11;
    G [label="agent-tuned, forward-reproducible\ncurrent-vintage 200d top cells", fillcolor="#ffd966", shape=octagon];
  }

  // Legend centering anchors
  legend -> prior [style="invis", weight=100];
  legend -> C1 [style="invis", weight=100];
  legend -> FIN [style="invis", weight=100];
  legend -> G  [style="invis", weight=100];

  // context -> start
  ident -> C1 [style="dashed", color="#999999"];

  // sequential single-writer chain (red)
  C1 -> C2 [color="#cc3333", penwidth=2, label="then (single-writer)"];
  C2 -> C3 [color="#cc3333", penwidth=2, label="then"];

  // each cell -> its own commit
  C1 -> K1 [color="#2e8b57"];
  C2 -> K2 [color="#2e8b57"];
  C3 -> K3 [color="#2e8b57"];

  // commits -> finalize
  K1 -> FIN [style="dashed", color="#338866"];
  K2 -> FIN [style="dashed", color="#338866"];
  K3 -> FIN [color="#2e8b57", penwidth=2];

  FIN -> G [color="#cc3333", penwidth=2];

  // follow-up investigation (queued, task #17)
  INV [label=<<B>_268 ✓</B> why agent &lt; sweep (2×2 backend×tuning)<BR/>BACKEND dominates — CatBoost robust, lowest eval→test decay<BR/>+ eval-overfit (cell-dep: rescued sp500, hurt russell); vintage REJECTED<BR/>→ use CatBoost sweep for H=200>, fillcolor="#cccccc"];
  G -> INV [style="dashed", color="#999999", label="follow-up (task #17) ✓"];

  // _268 recommended follow-up (now actioned)
  TBD [label=<V1.5_TBD #1: CatBoost agent-tune<BR/>vs CatBoost sweep — actioned>, fillcolor="#cccccc"];
  INV -> TBD [style="dashed", color="#999999", label="promoted"];

  // CatBoost agent-tune phase (3 cells, sequential single-writer)
  subgraph cluster_cbtune {
    label = "CatBoost agent-tune ×3 (V1.5_TBD #1 — can tuning the robust backend beat the CatBoost sweep?)";
    style = "rounded"; color = "#aa3399"; fontname = "Helvetica-Bold"; fontsize = 11;
    CBR  [label=<<B>CB-R ✓</B> russell1000 +40%/200d<BR/>@1 0.567 vs sweep 0.740 — LOST @1, edged @3>, fillcolor="#cccccc"];
    CB50 [label=<<B>CB-50 ✓</B> sp500 +50%/200d<BR/>@1 0.930 vs sweep 0.630 — WON big (+0.30)>, fillcolor="#a4e9a4"];
    CB40 [label=<<B>CB-40 ✓</B> sp500 +40%/200d<BR/>@1 0.557 vs sweep 0.727 — LOST @1, won @3>, fillcolor="#cccccc"];
    M269 [label=<<B>_269</B> memo + PR (in-flight)<BR/>high-variance: 1 win, 2 @1 losses → sweep stays default>, fillcolor="#a3c8e8"];
  }
  TBD -> CBR [color="#aa3399", penwidth=2];
  CBR  -> CB50 [color="#cc3333", penwidth=2, label="then (single-writer)"];
  CB50 -> CB40 [color="#cc3333", penwidth=2, label="then"];
  CB40 -> M269 [color="#aa3399"];

  G2 [label="CatBoost 200d top cells that beat the sweep\n(or a documented null — sweep stays the baseline)", fillcolor="#ffd966", shape=octagon];
  M269 -> G2 [color="#aa3399", penwidth=2];
  legend -> CBR [style="invis", weight=100];
}
